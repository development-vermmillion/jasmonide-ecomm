# Copy to .env.local and edit
AUTH_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
# SQLite file (default). For hosted DB use Turso: libsql://your-db.turso.io + DATABASE_AUTH_TOKEN
DATABASE_URL=file:./data/store.db
DATABASE_AUTH_TOKEN=

# Optional (free): let a local Ollama model phrase assistant replies. Install Ollama, run `ollama pull llama3.2`, then set:
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
